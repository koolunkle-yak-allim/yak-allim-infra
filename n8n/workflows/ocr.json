    {
      "parameters": {
        "jsCode": "const ocrResponse = $input.all()[0].json;\nconst firstPage = ocrResponse.pages?.[0] || {};\nconst pageWords = firstPage.words || [];\n\nconst formattedWords = pageWords.map(word => {\n  return {\n    text: word.text,\n    coordinates: word.boundingBox?.vertices || []\n  };\n});\n\nlet jobId = \"JOB_ID_NOT_FOUND\";\n\ntry {\n  const webhookData = $('Webhook').item.json;\n  jobId = webhookData.query?.jobId || \"JOB_ID_NOT_FOUND\";\n} catch (e) {\n  try {\n    const webhookAll = $('Webhook').all();\n    jobId = webhookAll[0]?.json?.query?.jobId || \"JOB_ID_NOT_FOUND\";\n  } catch (err) {\n    jobId = \"JOB_ID_NOT_FOUND\";\n  }\n}\n\nreturn [{\n  json: {\n    jobId: jobId,\n    extracted_text: firstPage.text || ocrResponse.text || \"\",\n    words_with_coordinates: formattedWords\n  }\n}];"
      },
