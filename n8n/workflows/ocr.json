      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"prescriptions\": {\n      \"type\": \"array\",\n      \"description\": \"추출된 처방약 목록 배열\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"medicineName\": { \n            \"type\": \"string\",\n            \"description\": \"정확한 약품명 (예: 이모튼캡슐, 바이독시정)\" \n          },\n          \"dosagePerTake\": { \n            \"type\": \"string\",\n            \"description\": \"1회 투약량 (예: 1정, 1캡슐)\" \n          },\n          \"dailyFrequency\": { \n            \"type\": \"integer\",\n            \"description\": \"하루 투약 횟수. 반드시 정수형태의 숫자여야 함 (예: 1, 2)\" \n          },\n          \"durationDays\": { \n            \"type\": \"integer\",\n            \"description\": \"총 투약 일수. 반드시 정수형태의 숫자여야 함 (예: 30)\" \n          },\n          \"bounds\": {\n            \"type\": \"array\",\n            \"description\": \"약품명이 위치한 사각형 좌표 영역 배열\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"points\": { \n                  \"type\": \"array\", \n                  \"description\": \"x, y 객체들로 이루어진 4개의 꼭짓점 배열\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"x\": { \"type\": \"number\" },\n                      \"y\": { \"type\": \"number\" }\n                    },\n                    \"required\": [\"x\", \"y\"]\n                  } \n                }\n              },\n              \"required\": [\"points\"]\n            }\n          }\n        },\n        \"required\": [\"medicineName\", \"dosagePerTake\", \"dailyFrequency\", \"durationDays\", \"bounds\"]\n      }\n    }\n  },\n  \"required\": [\"prescriptions\"]\n}"
      },
