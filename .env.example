# ----------------------------------------------------
# Yak-Allim Infrastructure Environment Configurations
# ----------------------------------------------------

# N8N Configuration
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# N8N_DATA_PATH / DEPLOY_DIR 기본값은 Windows 호스트 기준입니다.
# macOS/Linux에서는 아래처럼 절대 경로로 바꿔 쓰세요 (예시):
#   N8N_DATA_PATH=/opt/yak-allim/n8n_data
#   DEPLOY_DIR=/opt/yak-allim/deploy
N8N_DATA_PATH=C:/n8n_data

# Deployment Storage Path
DEPLOY_DIR=C:/yakallim-deploy
